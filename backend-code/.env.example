# ==========================================
# QUIUBOLE BACKEND - VARIABLES DE ENTORNO
# ==========================================

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=quiubole_db
DATABASE_USER=quiubole_user
DATABASE_PASSWORD=tu_password_seguro

# JWT
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui
JWT_EXPIRES_IN=7d

# ==========================================
# FIREBASE (Notificaciones Push)
# ==========================================
# Opción 1: Credenciales como JSON string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"quiubole-app",...}

# Opción 2: Credenciales individuales
FIREBASE_PROJECT_ID=quiubole-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@quiubole-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBg...\n-----END PRIVATE KEY-----\n"

# ==========================================
# PAGOS (próximo a implementar)
# ==========================================
# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Conekta (alternativa para México)
CONEKTA_API_KEY=key_...
CONEKTA_PUBLIC_KEY=key_...

# ==========================================
# GOOGLE MAPS (próximo a implementar)
# ==========================================
GOOGLE_MAPS_API_KEY=AIza...

# ==========================================
# CLOUDINARY (próximo a implementar)
# ==========================================
CLOUDINARY_CLOUD_NAME=quiubole
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abc123...

# ==========================================
# EMAIL (próximo a implementar)
# ==========================================
# SendGrid
SENDGRID_API_KEY=SG.xxx...
EMAIL_FROM=noreply@quiubole.com
EMAIL_FROM_NAME=Quiúbole!

# ==========================================
# OPENAI (para chatbot - próximo)
# ==========================================
OPENAI_API_KEY=sk-...

# ==========================================
# URLs
# ==========================================
FRONTEND_URL=http://localhost:3000
MOBILE_SCHEME=quiubole
