# ==========================================
# DEVOLÓN BACKEND — variables de entorno
#
# Para dev local: copia este archivo a `.env` y completa los valores.
# Para producción (Railway/Render): configúralos en el dashboard del PaaS.
# ==========================================

# Entorno: development | staging | production
NODE_ENV=development

# Puerto donde escucha NestJS. En Railway/Render el PaaS lo inyecta auto.
PORT=4000

# ============================================
# BASE DE DATOS
#
# Opción 1 (recomendado en prod): DATABASE_URL completa
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quiubole_db
#
# Opción 2 (dev local): vars discretas (se ignoran si hay DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=quiubole_db
#
# Forzar `synchronize:true` en producción para que TypeORM auto-cree
# tablas. SOLO úsalo en el primer deploy / MVP. Después → migraciones.
DB_SYNCHRONIZE=true

# ============================================
# AUTENTICACIÓN
# JWT secret — usa una string aleatoria larga en producción.
JWT_SECRET=cambia-esto-por-algo-aleatorio-muy-largo-en-produccion
JWT_EXPIRES_IN=7d

# ============================================
# CORS
# Lista CSV de dominios permitidos. En dev puedes dejar vacío (= *).
# Ej en prod: https://app.devolon.mx,https://admin.devolon.mx
CORS_ORIGIN=

# ============================================
# EMAIL (verificación, reset password)
# Recomendado: Resend (resend.com) o SendGrid.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Devolón <noreply@devolon.mx>

# ============================================
# PUSH NOTIFICATIONS (Expo)
# Expo push no necesita API key — solo el token del cliente.
# Opcional: si usas Expo access token para enviar > 600 notifs/seg
EXPO_ACCESS_TOKEN=

# ============================================
# STRIPE (pagos)
# Test keys empiezan con sk_test_ / pk_test_
# Live keys con sk_live_ / pk_live_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# CLOUDINARY (fotos de productos, avatares)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# GOOGLE MAPS (cuando integremos mapas reales en el driver)
GOOGLE_MAPS_API_KEY=

# ============================================
# OPENAI (chatbot Devo)
OPENAI_API_KEY=
